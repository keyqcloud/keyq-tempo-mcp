{
  "name": "@keyqinc/tempo-mcp",
  "version": "1.14.0",
  "description": "MCP server for KeyQ Tempo sprint-card workflow with Claude Code (sprint-mode v1)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "keyq-tempo-mcp": "dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepare": "tsup"
  },
  "keywords": [
    "mcp",
    "claude-code",
    "keyq",
    "tempo",
    "sprint"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keyqcloud/keyq-tempo-mcp.git"
  },
  "homepage": "https://github.com/keyqcloud/keyq-tempo-mcp#readme",
  "bugs": {
    "url": "https://github.com/keyqcloud/keyq-tempo-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsup": "^8.4.0",
    "tsx": "^4.19.4",
    "typescript": "^5.7.3"
  }
}
